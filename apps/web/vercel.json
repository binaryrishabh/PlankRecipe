{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/r/:slug", "destination": "/api/r?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/recipes", "destination": "/api/page?p=recipes" },
    { "source": "/extension", "destination": "/api/page?p=extension" },
    { "source": "/kitchen", "destination": "/api/page?p=kitchen" },
    { "source": "/privacy", "destination": "/api/page?p=privacy" }
  ]
}
